Keywords: "connected", "reachable", "island", "region", "path exists"

DFS TEMPLATE (graph):

vector<bool> visited(n, false);

void dfs(int node, vector<vector<int>>& adj) {
    visited[node] = true;
    for (int nb : adj[node])
        if (!visited[nb])
            dfs(nb, adj);
}

int count = 0;
for (int i = 0; i < n; i++)
    if (!visited[i]) { dfs(i, adj); count++; }
BFS TEMPLATE (graph):

vector<bool> visited(n, false);
queue<int> q;
q.push(start);
visited[start] = true;

while (!q.empty()) {
    int node = q.front(); q.pop();
    for (int nb : adj[node])
        if (!visited[nb]) { visited[nb] = true; q.push(nb); }
}
DFS TEMPLATE (grid):

void dfs(vector<vector<char>>& grid, int r, int c) {
    if (r < 0 || r >= grid.size() || c < 0 || c >= grid[0].size())
        return;
    if (grid[r][c] != '1') return;
    grid[r][c] = '0';   // mark visited by modifying the grid
    dfs(grid, r+1, c); dfs(grid, r-1, c);
    dfs(grid, r, c+1); dfs(grid, r, c-1);
}
EXAMPLE — Number of Islands
https://leetcode.com/problems/number-of-islands

For each unvisited '1', run DFS and sink all connected land.
Each DFS call = one island.

int numIslands(vector<vector<char>>& grid) {
    int ans = 0;
    for (int r = 0; r < grid.size(); r++)
        for (int c = 0; c < grid[0].size(); c++)
            if (grid[r][c] == '1') { dfs(grid, r, c); ans++; }
    return ans;
}
EXAMPLE — Clone Graph
https://leetcode.com/problems/clone-graph

DFS with a hashmap {original → clone}.
Before recursing, create the clone and store it.
If already in map, return the clone directly (handles cycles).

unordered_map<Node*, Node*> cloned;

Node* dfs(Node* node) {
    if (cloned.count(node)) return cloned[node];
    Node* copy = new Node(node->val);
    cloned[node] = copy;
    for (Node* nb : node->neighbors)
        copy->neighbors.push_back(dfs(nb));
    return copy;
}
