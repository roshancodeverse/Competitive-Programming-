TYPE 3 — EXPRESSION EVALUATION
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

When to use:
→ Evaluate mathematical expressions with +, -, *, /
→ Handle operator precedence and parentheses
→ Decode or expand nested structures

The idea: use a stack to defer computation.
On '(' → push current result and sign, start fresh.
On ')' → combine current result with what was pushed.

EXAMPLE — Evaluate Reverse Polish Notation
https://leetcode.com/problems/evaluate-reverse-polish-notation

RPN (postfix) has no parentheses. Operators come after their operands.
Push numbers. When you see an operator → pop two numbers, apply, push result.

int evalRPN(vector<string>& tokens) {
    stack<long long> st;
    for (string& t : tokens) {
        if (t == "+" || t == "-" || t == "*" || t == "/") {
            long long b = st.top(); st.pop();
            long long a = st.top(); st.pop();
            if (t == "+") st.push(a + b);
            if (t == "-") st.push(a - b);
            if (t == "*") st.push(a * b);
            if (t == "/") st.push(a / b);
        } else {
            st.push(stoll(t));
        }
    }
    return st.top();
}
EXAMPLE — Basic Calculator II (no parentheses, has * and /)
https://leetcode.com/problems/basic-calculator-ii

Process left to right. For + and - → push the number (with sign).
For * and / → pop the last number, compute, push result.
Final answer = sum of everything on the stack.

int calculate(string s) {
    stack<int> st;
    int num = 0;
    char op = '+';
    for (int i = 0; i <= s.size(); i++) {
        char c = s[i];
        if (isdigit(c)) { num = num * 10 + (c - '0'); }
        if ((!isdigit(c) && c != ' ') || i == s.size()) {
            if (op == '+') st.push(num);
            if (op == '-') st.push(-num);
            if (op == '*') { int t = st.top(); st.pop(); st.push(t * num); }
            if (op == '/') { int t = st.top(); st.pop(); st.push(t / num); }
            op = c;
            num = 0;
        }
    }
    int ans = 0;
    while (!st.empty()) { ans += st.top(); st.pop(); }
    return ans;
}
EXAMPLE — Decode String
https://leetcode.com/problems/decode-string

"3[a2[bc]]" → "abcbcabcbcabcbc"
When you see '[': push current string and repeat count onto stack, reset both.
When you see ']': pop count and prefix, append current string repeated.

string decodeString(string s) {
    stack<int>    counts;
    stack<string> strs;
    string cur;
    int k = 0;
    for (char c : s) {
        if (isdigit(c)) {
            k = k * 10 + (c - '0');
        } else if (c == '[') {
            counts.push(k); k = 0;
            strs.push(cur); cur = "";
        } else if (c == ']') {
            int times = counts.top(); counts.pop();
            string prev = strs.top(); strs.pop();
            for (int i = 0; i < times; i++) prev += cur;
            cur = prev;
        } else {
            cur += c;
        }
    }
    return cur;
}
