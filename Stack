TYPE 4 — STACK SIMULATION
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

When to use:
→ Elements interact with previously seen elements
→ New elements can destroy, cancel, or modify the top of the stack
→ "Simulate" a process that requires looking at what came before

EXAMPLE — Asteroid Collision
https://leetcode.com/problems/asteroid-collision

Positive asteroids move right, negative move left.
Collision happens when a positive is followed by a negative (stack top > 0, cur < 0).
Simulate: push onto stack. If collision → compare sizes.

vector<int> asteroidCollision(vector<int>& asteroids) {
    stack<int> st;
    for (int a : asteroids) {
        bool survived = true;
        while (survived && a < 0 && !st.empty() && st.top() > 0) {
            if (st.top() < -a) st.pop();        // stack asteroid destroyed
            else if (st.top() == -a) { st.pop(); survived = false; }  // both destroyed
            else survived = false;                 // new one destroyed
        }
        if (survived) st.push(a);
    }
    vector<int> res;
    while (!st.empty()) { res.push_back(st.top()); st.pop(); }
    reverse(res.begin(), res.end());
    return res;
}
EXAMPLE — Remove All Adjacent Duplicates in String
https://leetcode.com/problems/remove-all-adjacent-duplicates-in-string

Push characters. If current == top → they cancel → pop.
Stack contains the result at the end.

string removeDuplicates(string s) {
    stack<char> st;
    for (char c : s) {
        if (!st.empty() && st.top() == c) st.pop();
        else st.push(c);
    }
    string res;
    while (!st.empty()) { res += st.top(); st.pop(); }
    reverse(res.begin(), res.end());
    return res;
}
EXAMPLE — Min Stack
https://leetcode.com/problems/min-stack

Support push/pop/top/getMin in O(1).
Use a second stack that tracks the minimum at each level.
When you push: push min(val, min_stack.top()) onto the min stack.

class MinStack {
    stack<int> st, minSt;
public:
    void push(int val) {
        st.push(val);
        minSt.push(minSt.empty() ? val : min(val, minSt.top()));
    }
    void pop() { st.pop(); minSt.pop(); }
    int top()  { return st.top(); }
    int getMin() { return minSt.top(); }
};
