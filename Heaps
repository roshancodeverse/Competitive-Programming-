TYPE 2 — MERGE K SORTED LISTS / ARRAYS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

When to use:
→ Merge k sorted arrays or linked lists
→ Find the smallest element across k sorted sequences
→ "Find the k-th smallest in a sorted matrix"

Keywords: "merge k sorted", "k sorted lists", "sorted matrix"

KEY INSIGHT:
You have k sorted sources. You want to extract elements in order.
Put the current smallest element of EACH source into a min-heap.
Always pop the minimum, then push the next element from that same source.

TEMPLATE — Merge K Sorted Arrays:

// {value, array_index, element_index}
priority_queue<tuple<int,int,int>, vector<tuple<int,int,int>>, greater<>> minH;

// Seed with the first element of each array
for (int i = 0; i < arrays.size(); i++)
    if (!arrays[i].empty())
        minH.push({arrays[i][0], i, 0});

vector<int> result;
while (!minH.empty()) {
    auto [val, i, j] = minH.top(); minH.pop();
    result.push_back(val);
    if (j + 1 < arrays[i].size())
        minH.push({arrays[i][j+1], i, j+1});
}
EXAMPLE — Merge K Sorted Lists
https://leetcode.com/problems/merge-k-sorted-lists

Same template but for linked lists.
Push head of each list. After popping a node, push node->next.

ListNode* mergeKLists(vector<ListNode*>& lists) {
    auto cmp = [](ListNode* a, ListNode* b) { return a->val > b->val; };
    priority_queue<ListNode*, vector<ListNode*>, decltype(cmp)> minH(cmp);

    for (ListNode* l : lists)
        if (l) minH.push(l);

    ListNode dummy(0);
    ListNode* cur = &dummy;
    while (!minH.empty()) {
        cur->next = minH.top(); minH.pop();
        cur = cur->next;
        if (cur->next) minH.push(cur->next);
    }
    return dummy.next;
}
EXAMPLE — Kth Smallest Element in a Sorted Matrix
https://leetcode.com/problems/kth-smallest-element-in-a-sorted-matrix

Treat each row as a sorted list. Merge k rows and return k-th element.

int kthSmallest(vector<vector<int>>& matrix, int k) {
    int n = matrix.size();
    // {value, row, col}
    priority_queue<tuple<int,int,int>, vector<tuple<int,int,int>>, greater<>> minH;
    for (int i = 0; i < n; i++)
        minH.push({matrix[i][0], i, 0});

    int ans = 0;
    while (k--) {
        auto [val, r, c] = minH.top(); minH.pop();
        ans = val;
        if (c + 1 < n) minH.push({matrix[r][c+1], r, c+1});
    }
    return ans;
}
