EXAMPLE — Process Tasks Using Servers
https://leetcode.com/problems/process-tasks-using-servers

Two heaps:
free servers → min-heap sorted by (weight, index)
busy servers → min-heap sorted by (free_at_time, weight, index)

For each task, if no free server, advance time to when the next one frees up.

vector<int> assignTasks(vector<int>& servers, vector<int>& tasks) {
    // {weight, index}
    priority_queue<pair<int,int>, vector<pair<int,int>>, greater<>> freeH;
    // {free_at, weight, index}
    priority_queue<tuple<int,int,int>, vector<tuple<int,int,int>>, greater<>> busyH;

    for (int i = 0; i < servers.size(); i++)
        freeH.push({servers[i], i});

    vector<int> ans(tasks.size());
    for (int i = 0; i < tasks.size(); i++) {
        int t = i;
        // Free up servers that are done
        while (!busyH.empty() && get<0>(busyH.top()) <= t) {
            auto [at, w, idx] = busyH.top(); busyH.pop();
            freeH.push({w, idx});
        }
        // If no free server, jump time
        if (freeH.empty()) {
            t = get<0>(busyH.top());
            while (!busyH.empty() && get<0>(busyH.top()) <= t) {
                auto [at, w, idx] = busyH.top(); busyH.pop();
                freeH.push({w, idx});
            }
        }
        auto [w, idx] = freeH.top(); freeH.pop();
        ans[i] = idx;
        busyH.push({t + tasks[i], w, idx});
    }
    return ans;
}
