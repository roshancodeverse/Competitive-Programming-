COUNTING SET BITS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Built-in (always prefer this)
__builtin_popcount(x)     // int
__builtin_popcountll(x)   // long long

// Manual (uses the clear-lowest-bit trick)
int countBits(int x) {
    int count = 0;
    while (x) {
        x &= (x - 1);   // clears one set bit per iteration
        count++;
    }
    return count;
}

// Brian Kernighan's algorithm — same idea, cleaner loop
