SHIFT TRICKS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

x << 1   ==  x * 2
x << k   ==  x * 2^k
x >> 1   ==  x / 2   (for non-negative x)
x >> k   ==  x / 2^k

// 1 << k  gives the k-th power of 2
1 << 0  =  1
1 << 1  =  2
1 << 2  =  4
1 << 10 =  1024

// IMPORTANT: use 1LL << k when k >= 31 to avoid int overflow
long long mask = 1LL << 35;
