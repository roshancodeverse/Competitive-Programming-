XOR TRICKS — THE MOST USEFUL ONES
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

The three XOR laws you need to know:
  x ^ x  =  0    (anything XORed with itself is 0)
  x ^ 0  =  x    (anything XORed with 0 is itself)
  XOR is commutative and associative

// Swap two variables without a temp
a ^= b;
b ^= a;
a ^= b;
// Works but use std::swap in practice — this is just good to know.

// Find the single number in an array where every other appears twice
int single = 0;
for (int x : nums) single ^= x;
// All pairs cancel out (x^x=0), the lone number remains.
// LeetCode 136 — Single Number

// Find two non-repeating numbers when everything else appears twice
int xorAll = 0;
for (int x : nums) xorAll ^= x;
// xorAll = a ^ b. Find any set bit in xorAll (they differ there).
int bit = xorAll & (-xorAll);   // lowest set bit
int a = 0, b = 0;
for (int x : nums) {
    if (x & bit) a ^= x;
    else          b ^= x;
}
// LeetCode 260 — Single Number III

// Check if two numbers have opposite signs
bool oppositeSigns = (x ^ y) < 0;
