__builtin_ctz(x)           // count trailing zeros (x must be > 0)
__builtin_ctzll(x)         // count trailing zeros (long long)
// position of lowest set bit = __builtin_ctz(x)

__builtin_parity(x)        // 1 if odd number of set bits, 0 if even
