__builtin_popcount(x)      // count of 1 bits (int)
__builtin_popcountll(x)    // count of 1 bits (long long)

__builtin_clz(x)           // count leading zeros (int, x must be > 0)
__builtin_clzll(x)         // count leading zeros (long long)
