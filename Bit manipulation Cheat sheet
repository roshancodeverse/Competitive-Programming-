THE BASICS — OPERATORS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

&   AND      — 1 only when BOTH bits are 1
|   OR       — 1 when EITHER bit is 1
^   XOR      — 1 when bits are DIFFERENT
~   NOT      — flips all bits  (~5 = -6 in two's complement)
<<  left shift   — multiply by 2 per shift
>>  right shift  — divide by 2 per shift (arithmetic for signed)

5  =  0101
6  =  0110

5 & 6  =  0100  =  4
5 | 6  =  0111  =  7
5 ^ 6  =  0011  =  3
~5     =  ...11111010  =  -6
