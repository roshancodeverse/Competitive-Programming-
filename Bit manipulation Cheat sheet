POWER OF 2 TRICKS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Check if x is a power of 2
bool isPow2 = (x > 0) && (x & (x - 1)) == 0;

Why it works:
  Powers of 2 in binary have exactly one 1 bit.
  16  =  10000
  15  =  01111
  16 & 15  =  00000  →  0, so it IS a power of 2.

  Non-power: 12 = 1100, 11 = 1011, 12 & 11 = 1000 ≠ 0.

// Next power of 2 greater than or equal to x
int nextPow2(int x) {
    if (x <= 0) return 1;
    x--;
    x |= x >> 1;
    x |= x >> 2;
    x |= x >> 4;
    x |= x >> 8;
    x |= x >> 16;
    return x + 1;
}
