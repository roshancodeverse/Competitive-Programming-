SIEVE OF ERATOSTHENES (All primes up to n)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  When you need all primes up to n, sieve is O(n log log n) —
  much faster than checking each number individually.

  vector<bool> sieve(int n) {
      vector<bool> isPrime(n + 1, true);
      isPrime[0] = isPrime[1] = false;
      for (int i = 2; i * i <= n; i++) {
          if (isPrime[i]) {
              for (int j = i * i; j <= n; j += i) {
                  isPrime[j] = false;
              }
          }
      }
      return isPrime;
  }

  // Usage
  auto prime = sieve(1000000);
  if (prime[17]) { }   // true — 17 is prime

  // Collect all primes into a vector
  vector<int> primes;
  for (int i = 2; i <= n; i++)
      if (prime[i]) primes.push_back(i);

  // Why start inner loop at i*i?
  // All smaller multiples of i were already marked by smaller primes.
