PRIME FACTORIZATION
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  // Get all prime factors of n — O(sqrt(n))
  vector<int> primeFactors(int n) {
      vector<int> factors;
      for (int i = 2; i * i <= n; i++) {
          while (n % i == 0) {
              factors.push_back(i);
              n /= i;
          }
      }
      if (n > 1) factors.push_back(n);   // remaining prime factor
      return factors;
  }

  primeFactors(12)  →  [2, 2, 3]
  primeFactors(17)  →  [17]

