MODULAR INVERSE
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Division does not work directly under modulo.
To compute (a / b) % mod, you need the modular inverse of b.

The modular inverse of b is a number x such that:
  b * x ≡ 1  (mod m)

  // When mod is PRIME — use Fermat's Little Theorem
  // b^(mod-1) ≡ 1 (mod p)  →  b^(mod-2) ≡ b⁻¹ (mod p)

  long long modInverse(long long b, long long mod) {
      return fastPow(b, mod - 2, mod);   // mod must be prime
  }

  // Division under mod
  long long divide(long long a, long long b, long long mod) {
      return a % mod * modInverse(b, mod) % mod;
  }

  // When mod is NOT prime — use Extended Euclidean Algorithm
  long long extGCD(long long a, long long b, long long &x, long long &y) {
      if (b == 0) { x = 1; y = 0; return a; }
      long long x1, y1;
      long long g = extGCD(b, a % b, x1, y1);
      x = y1;
      y = x1 - (a / b) * y1;
      return g;
  }

  long long modInverseExt(long long b, long long mod) {
      long long x, y;
      long long g = extGCD(b, mod, x, y);
      // inverse exists only if gcd(b, mod) == 1
      return (x % mod + mod) % mod;
  }
