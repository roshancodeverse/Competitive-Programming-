━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  // Euclidean algorithm — O(log min(a, b))
  int gcd(int a, int b) {
      return b == 0 ? a : gcd(b, a % b);
  }

  // LCM — divide first to avoid overflow
  long long lcm(long long a, long long b) {
      return a / gcd(a, b) * b;
  }

  // C++17 built-ins  (include <numeric>)
  #include <numeric>
  gcd(a, b)    // works on int and long long
  lcm(a, b)    // works on int and long long

  // GCD of an entire array
  int result = nums[0];
  for (int x : nums) result = gcd(result, x);

  // Key property: gcd(a, b) = gcd(b, a % b) = gcd(a - b, b)
  // LCM × GCD = a × b   →   lcm = a / gcd * b
