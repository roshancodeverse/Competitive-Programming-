FAST POWER (Binary Exponentiation)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Compute a^b % mod in O(log b) instead of O(b).

  long long fastPow(long long base, long long exp, long long mod) {
      long long result = 1;
      base %= mod;
      while (exp > 0) {
          if (exp & 1) result = result * base % mod;   // if current bit is set
          base = base * base % mod;                     // square the base
          exp >>= 1;                                    // move to next bit
      }
      return result;
  }

  fastPow(2, 10, MOD)   →  1024
  fastPow(2, 1e9, MOD)  →  computed in ~30 iterations

