COMBINATIONS — nCr
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  nCr = n! / (r! * (n-r)!)

  // Small n — Pascal's Triangle  O(n²) precomputation
  vector<vector<long long>> C(n + 1, vector<long long>(n + 1, 0));
  C[0][0] = 1;
  for (int i = 1; i <= n; i++) {
      C[i][0] = 1;
      for (int j = 1; j <= i; j++)
          C[i][j] = C[i-1][j-1] + C[i-1][j];
  }
  // C[n][r] gives nCr

  // Large n with modulo — precompute factorials and inverse factorials
  const int MAXN = 1e6 + 5;
  long long fact[MAXN], inv_fact[MAXN];

  void precompute(int n, long long mod) {
      fact[0] = 1;
      for (int i = 1; i <= n; i++)
          fact[i] = fact[i-1] * i % mod;
      inv_fact[n] = fastPow(fact[n], mod - 2, mod);
      for (int i = n - 1; i >= 0; i--)
          inv_fact[i] = inv_fact[i+1] * (i+1) % mod;
  }

  long long nCr(int n, int r, long long mod) {
      if (r < 0 || r > n) return 0;
      return fact[n] % mod * inv_fact[r] % mod * inv_fact[n-r] % mod;
  }
