PRIME CHECKING
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  // Check if a single number is prime — O(sqrt(n))
  bool isPrime(int n) {
      if (n < 2) return false;
      if (n == 2) return true;
      if (n % 2 == 0) return false;
      for (int i = 3; i * i <= n; i += 2) {
          if (n % i == 0) return false;
      }
      return true;
  }

  Why sqrt(n)?
    If n has a factor > sqrt(n), its paired factor is < sqrt(n).
    So checking up to sqrt(n) is sufficient.
