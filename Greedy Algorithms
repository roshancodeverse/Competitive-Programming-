━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Greedy works when → local best never prevents a better future choice
Greedy fails when → future steps can invalidate the current choice → use DP
Interval scheduling → sort by END time, keep earliest-ending non-overlapping
Arrows / coverage → sort by end, one arrow covers until it misses
Jump reachability → track farthest, force jump when range exhausted
Match two groups → sort both, match smallest to smallest
Custom order → compare ab vs ba as strings (Largest Number)
Two-direction constraint → two separate passes (Candy)
Running total reset → restart when tank drops below 0 (Gas Station)
Partition by range → extend until index reaches farthest last occurrence
Dynamic best choice → max-heap, always pick top
